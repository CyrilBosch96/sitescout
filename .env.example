# SiteScout environment — secrets + environment selection.
# Copy this to .env and fill in real values. Never commit .env itself.

# "production" or "development" — the single switch controlling live sends,
# recipient overrides, and which Notion database gets read/written. See
# scripts/hp_env.py.
HP_ENV=

NOTION_API_KEY=
GOOGLE_PLACES_API_KEY=

# Production and TEST both live in the same Notion workspace/integration,
# just different databases.
NOTION_DATABASE_ID_PROD=
NOTION_DATA_SOURCE_ID_PROD=

NOTION_DATABASE_ID_TEST=
NOTION_DATA_SOURCE_ID_TEST=

# Only takes effect when HP_ENV != production — every send in dev/test
# redirects here instead of the lead's real address.
DEV_OVERRIDE_EMAIL=

# Track B (Ghost Sites) — Cloudflare Pages hosting.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Purchase-interest modal on every ghost site — client-side POST straight
# from the static page to Web3Forms, which emails the operator. Public-
# facing access key by Web3Forms' own design, safe to embed in static HTML.
WEB3FORMS_ACCESS_KEY=

# Reply classification + cold-email/hero-line copy generation (scripts/
# hp_llm.py). Free tier at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
